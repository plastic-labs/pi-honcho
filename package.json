{
  "name": "@honcho-ai/pi-honcho",
  "version": "0.1.0",
  "description": "Official Honcho memory extension for the pi coding agent",
  "keywords": [
    "honcho",
    "memory",
    "pi-extension",
    "pi-package"
  ],
  "homepage": "https://github.com/plastic-labs/pi-honcho#readme",
  "bugs": {
    "url": "https://github.com/plastic-labs/pi-honcho/issues"
  },
  "license": "MIT",
  "author": "Plastic Labs <hello@plasticlabs.ai> (https://plasticlabs.ai)",
  "contributors": [
    "Agney Menon (https://github.com/agneym)"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/plastic-labs/pi-honcho.git"
  },
  "files": [
    "extensions",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "lint:github": "oxlint --format=github",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish"
  },
  "dependencies": {
    "@honcho-ai/harness-plugin-core": "^0.1.1",
    "@honcho-ai/sdk": "^2.5.1"
  },
  "devDependencies": {
    "@changesets/cli": "^2.30.0",
    "@earendil-works/pi-coding-agent": "1.0.0",
    "@earendil-works/pi-tui": "1.0.0",
    "@types/node": "^22.19.0",
    "lefthook": "^2.1.4",
    "oxfmt": "^0.42.0",
    "oxlint": "^1.57.0",
    "oxlint-tsgolint": "^0.17.3",
    "typebox": "^1.3.27",
    "typescript": "^5.9.3",
    "vitest": "^4.1.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "engines": {
    "node": ">=22.19"
  },
  "packageManager": "pnpm@11.0.0-dev.1005+sha512.91f84a392eea348ea4852a182912d2520273a4336f933b78cc44bc931eb999923c097e9433a9b355adc1f725725ea99082fc9f032a559df832632e764c92c798",
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ]
  }
}
